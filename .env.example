# Variables de entorno del entorno Docker de desarrollo (docker-compose.yml).
#
# Copia este archivo a `.env` (que Git ignora) para cambiar algún valor:
#     cp .env.example .env
# No es obligatorio: sin `.env`, `docker compose up` arranca con los valores por defecto de abajo.
# NUNCA subas `.env` a Git ni pongas secretos reales en este archivo de ejemplo.

# --- Puertos del equipo (el contenedor siempre usa 3000, 3001 y 8000 por dentro) ---
# Cámbialos si ya tienes algo escuchando en esos puertos.
WEBSITE_HOST_PORT=3000
BACKOFFICE_HOST_PORT=3001
API_HOST_PORT=8000

# --- Comunicación entre servicios ---
# Dirección de la API vista desde el contenedor `ui`: el NOMBRE DEL SERVICIO de Compose, no localhost.
API_INTERNAL_URL=http://api:8000
# Dirección de la API que usa el navegador: una ruta del propio backoffice, que la reenvía a API_INTERNAL_URL.
NEXT_PUBLIC_INVENTORY_API_URL=/backend
# Telemetría: dónde envía el navegador los lotes de eventos (ruta del backoffice que reenvía a la API).
# Vacío = telemetría desactivada. Hoy apunta al receptor provisional; la fase con persistencia solo cambia este valor.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/backend/telemetry/events
# Telemetría, lado API: dirección del receptor (ruta de la API o URL completa); se valida al arrancar.
TELEMETRY_ENDPOINT=/telemetry/events

# --- API: base de datos y sesiones ---
# Vacío = SQLite de desarrollo dentro del volumen de Docker. Para Supabase:
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/postgres
DATABASE_URL=
# Vacío = el contenedor genera una clave aleatoria cada vez que arranca (las sesiones se pierden al reiniciar).
# Para conservar las sesiones, pon una clave aleatoria de 32 caracteres o más:
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- API: correo de recuperación de contraseña ---
# console = escribe el enlace en el log (docker compose logs api); resend = envía el correo con Resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=TrackFlow <onboarding@resend.dev>
# Dirección que abre la persona en su navegador.
FRONTEND_BASE_URL=http://localhost:3001
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# --- Cola de tareas (Celery + Redis) ---
# La API y los workers usan la MISMA URL. En Docker es el nombre del servicio `redis`; fuera de Docker, localhost.
REDIS_URL=redis://redis:6379/0
# Puertos del equipo para Redis y para Flower (el panel de la cola).
REDIS_HOST_PORT=6379
FLOWER_HOST_PORT=5555
# Segundos del primer reintento de una tarea fallida: espera 5, 10 y 20 y entonces va a la cola de mensajes muertos.
TASK_RETRY_BACKOFF_SECONDS=5

# --- API: análisis del archivo de incidencias ---
ANALYSIS_MAX_UPLOAD_MB=250
