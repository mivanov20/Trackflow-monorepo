# Copy this file to services/.env and fill in your own values. Never commit services/.env.

# --- Database and sessions ---
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/postgres
JWT_SECRET=<random-secret-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_DB_PATH=./services/data/users.json
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# --- Password recovery email (Resend, https://resend.com) ---
# resend   = send real emails through Resend (needs RESEND_API_KEY)
# console  = development only: print the reset link in the API log instead of sending it
# disabled = send nothing (default when this variable is empty)
EMAIL_PROVIDER=resend
RESEND_API_KEY=<your Resend API key, starts with re_>
# Resend's test sender only delivers to the email address of your own Resend account.
EMAIL_FROM=TrackFlow <onboarding@resend.dev>
# App that serves /reset-password; the emailed link is <FRONTEND_BASE_URL>/reset-password?token=...
FRONTEND_BASE_URL=http://localhost:3001
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# --- Incident file analysis ---
# Largest incidents CSV the API accepts for POST /api/incidents/analyze (default 250, about a million rows).
ANALYSIS_MAX_UPLOAD_MB=250
