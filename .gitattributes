# Los scripts y archivos de Docker se ejecutan dentro de contenedores Linux: siempre con saltos de línea LF.
# Sin esto, Git en Windows puede convertirlos a CRLF y el contenedor falla con "/bin/sh^M: bad interpreter".
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf

# A crontab must keep Unix line endings or cron rejects it
*.crontab text eol=lf

# Sample RFP PDFs are test inputs: never touch their bytes (line-ending conversion would break the PDF cross-reference table)
*.pdf binary
