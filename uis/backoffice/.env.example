# Variables del backoffice FUERA de Docker (cópialas a .env.local, que Git ignora).
# En Docker las define docker-compose.yml.

# API de inventario e incidencias vista desde el navegador.
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000

# Receptor de telemetría. Si falta o está vacío, el backoffice no envía telemetría.
# Hoy es el receptor provisional de la API; cuando exista el de persistencia solo cambia este valor.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
